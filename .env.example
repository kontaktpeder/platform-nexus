# .env  = public anon/publishable keys (committed — Lovable Vite needs these)
# .env.local = SERVICE_ROLE, DB password, access tokens (gitignored)

# --- Public Supabase (safe in committed .env) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# --- Secrets → put these in .env.local only ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ACCESS_TOKEN=your_sbp_personal_access_token
# SUPABASE_DB_PASSWORD=your_database_password

# --- Google Gemini (app AI: Mission brief, parse, replies) ---
# Create at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=  # optional alias for the same key

# --- Company logos (Logo.dev) — SERVER ONLY, no VITE_ ---
# Publishable key from https://www.logo.dev — store as Lovable Secret:
#   LOGO_DEV_PUBLISHABLE_KEY=pk_...
# App proxies via /api/logo so the browser never needs a VITE_ variable.
LOGO_DEV_PUBLISHABLE_KEY=pk_your_logo_dev_key

# --- Lovable connectors (Gmail / Slack via connector-gateway — not AI credits) ---
LOVABLE_API_KEY=your_lovable_api_key
GOOGLE_MAIL_API_KEY=your_gmail_connector_key

# --- Optional ---
# SLACK_API_KEY=
# MODULE_SECRETS_KEY=64_char_random_string_for_encrypting_module_keys
